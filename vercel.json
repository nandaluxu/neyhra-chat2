{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/chat/:id",
      "destination": "/index.html"
    },
    {
      "source": "/global",
      "destination": "/index.html"
    },
    {
      "source": "/bonus",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{char/**,public/**}"
    }
  }
}
