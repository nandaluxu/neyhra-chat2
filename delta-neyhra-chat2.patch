+  }
+  if (F.open) paintForm();
+}
+fm.addEventListener('click', e => {
+  if (e.target === fm) { closeForm(); return; }
+  const b = e.target.closest('[data-a]'); if (!b || b.disabled) return;
+  const a = b.dataset.a;
+  if (a === 'close') closeForm();
+  else if (a === 'pick') { F.item = b.dataset.id; F.qty = 1; F.price = ''; fmsg(''); paintForm(); }
