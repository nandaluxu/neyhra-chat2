+/* ===== Sub-tab Dompet > Kerja (job.js) =====
+   Memakai ulang wl-* dan tr-spin dari wallet.css; variabel tema --bg --surface --ink --mut --line --ok --rec. */
+.jb-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);grid-template-rows:auto 1fr;gap:14px;align-items:start}
+.jb-quota{grid-column:2;grid-row:1}
+.jb-main{grid-column:1;grid-row:1/span 2;display:flex;flex-direction:column;gap:14px;min-width:0}
+.jb-hist{grid-column:2;grid-row:2}
+@media(max-width:799px){
+  .jb-grid{grid-template-columns:minmax(0,1fr)}
+  .jb-quota,.jb-main,.jb-hist{grid-column:1;grid-row:auto}
+}
+
+/* kuota */
+.jb-quota{padding:16px 18px}
+.jb-qh{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
+.jb-qh h3{margin:0 0 8px}
+.jb-qn{font-size:22px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
+.jb-back{margin-top:12px;font-size:13px;line-height:1.5;color:var(--mut)}
+.jb-back b{color:var(--ink)}
+.jb-bonus{margin-top:8px;font-size:12.5px;color:var(--mut)}
+
+/* kartu pekerjaan */
+.jb-jobs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
+@media(max-width:799px){.jb-jobs{grid-template-columns:minmax(0,1fr)}}
+.jb-card{display:flex;flex-direction:column;gap:10px;min-width:0;padding:16px;border-radius:22px;background:var(--surface);border:1.5px solid transparent;transition:border-color .2s}
+.jb-card.ready{border-color:var(--ink)}
+.jb-head{display:flex;align-items:center;gap:12px;min-width:0;flex-wrap:wrap}
+.jb-ic{flex:none;width:44px;height:44px;border-radius:14px;background:var(--bg);display:grid;place-items:center}
+.jb-ic svg{width:24px;height:24px;fill:none;stroke:var(--ink);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
+.jb-t{flex:1;min-width:0}
+.jb-t b{display:block;font-size:15px;font-weight:600;line-height:1.25;overflow-wrap:anywhere}
+.jb-t small{display:block;font-size:12px;color:var(--mut)}
+.jb-pay{display:flex;align-items:center;gap:6px;flex:none}
+.jb-pay img{width:18px;height:18px}
+.jb-pay b{font-size:16px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
+.jb-pay span{font-size:12px;color:var(--mut)}
+.jb-desc{margin:0;font-size:13px;line-height:1.5;color:var(--mut)}
+.jb-act{margin-top:auto;display:flex;flex-direction:column;gap:10px}
+.jb-go{width:100%}
+.jb-cd{display:flex;flex-direction:column;gap:6px}
+.jb-cdt{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
+.jb-cdl{font-size:12.5px;color:var(--mut)}
+.jb-cdn{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:24px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
+.jb-cd .wl-track{background:var(--bg)}
+.jb-sr{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+.jb-card>.wl-msg{margin-top:0}
+.jb-go:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
+
+/* panel hasil */
+.jb-result{position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;padding:22px 18px;text-align:center;box-shadow:inset 0 0 0 1.5px var(--ok)}
+.jb-result.fresh{animation:jb-in .35s cubic-bezier(.2,.9,.3,1.1)}
+.jb-result.bonus{box-shadow:inset 0 0 0 2px var(--ink)}
+.jb-result .wl-x{position:absolute;top:8px;right:8px}
+.jb-rl{font-size:12.5px;font-weight:600;color:var(--mut)}
+.jb-amt{display:flex;align-items:center;gap:10px}
+.jb-amt img{width:30px;height:30px}
+.jb-amt b{font-size:40px;font-weight:700;letter-spacing:-.04em;font-variant-numeric:tabular-nums;color:var(--ok)}
+.jb-result.bonus .jb-amt b{color:var(--ink)}
+.jb-amt span{font-size:14px;color:var(--mut)}
+.jb-note{margin:0;font-size:12.5px;color:var(--mut)}
+.jb-spark{margin:2px 0 0;font-size:14px;font-weight:700;letter-spacing:.02em}
+.jb-result.fresh .jb-spark{animation:jb-pop .6s cubic-bezier(.2,1.4,.3,1) both}
+@keyframes jb-in{from{opacity:0;transform:translateY(8px) scale(.98)}to{opacity:1;transform:none}}
+@keyframes jb-pop{0%{opacity:0;transform:scale(.6)}60%{opacity:1;transform:scale(1.12)}100%{transform:scale(1)}}
+
+/* riwayat */
+.jb-hist{padding:16px 18px}
+.jb-hist h3{margin-bottom:6px}
+.jb-hl{list-style:none;margin:0;padding:0}
+.jb-hl li{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
+.jb-hl li:last-child{border-bottom:0}
+.jb-ht{flex:1;min-width:0}
+.jb-ht span{display:block;font-size:13.5px;line-height:1.35;overflow-wrap:anywhere}
+.jb-ht small{display:block;font-size:12px;color:var(--mut)}
+.jb-hc{flex:none;font-size:14px;font-weight:700;color:var(--ok);font-variant-numeric:tabular-nums}
+.jb-empty{margin:8px 0 0;font-size:13px;line-height:1.5;color:var(--mut)}
+
+@media(prefers-reduced-motion:reduce){.jb-result.fresh,.jb-result.fresh .jb-spark{animation:none}.jb-card{transition:none}}
